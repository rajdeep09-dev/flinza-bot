# ==============================================================================
# Flinza — Enterprise Outreach OS & AI Agent Fleet
# Reference Environment Template (.env.example)
# ==============================================================================

# ─── 1. Telegram Autonomous Bot & Remote Shell ────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_ID=your_numeric_telegram_user_id
TELEGRAM_BOT_TOKEN_LEGACY=

# ─── 2. Multi-LLM AI Routing Engine ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
NVIDIA_API_KEY=your_nvidia_nim_api_key
MISTRAL_API_KEY=your_mistral_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
SCRAPINGDOG_API_KEY=your_scrapingdog_api_key

# Apify Actor Token Pool
APIFY_API_TOKEN_1=
APIFY_API_TOKEN_2=
APIFY_API_TOKEN_3=
APIFY_API_TOKEN_4=
APIFY_API_TOKEN_5=

# ─── 3. Cloudflare Account & Multi-Domain DNS Fleet ───────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_DOMAIN=flinzaworks.site
CF_ZONE_ID=your_primary_cloudflare_zone_id

# Cloudflare Zone IDs for Multi-Domain Fleet
CF_ZONE_FLINZAWORKS_SITE=
CF_ZONE_TRYFLINZAWORKS_SITE=
CF_ZONE_FLINZAWORKS_ONLINE=
CF_ZONE_MAGICFITPARTNERS=

# ─── 4. Amazon SES High-Volume Outbound Relay ─────────────────────────────────
AWS_SES_REGION=eu-north-1
AWS_SES_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=your_ses_smtp_user
AWS_SES_SMTP_PASS=your_ses_smtp_password
AWS_ACCOUNT_ID=
AWS_SES_ARN_FLINZAWORKS_SITE=
AWS_SES_ARN_TRYFLINZAWORKS_SITE=

# ─── 5. Brevo SMTP Backup & Rate-Limit Failover Relay ─────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# ─── 6. Zoho Mail India (zoho.in) Corporate Inboxes ───────────────────────────
ZOHO_SMTP_HOST=smtppro.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_IMAP_HOST=imappro.zoho.in
ZOHO_IMAP_PORT=993

# ─── 7. Connected Master Gmail Inboxes & App Passwords ────────────────────────
GMAIL_PRIMARY=your_primary_email@gmail.com
GMAIL_PRIMARY_PASS=your_16_char_app_password
GMAIL_SECONDARY=your_secondary_email@gmail.com
GMAIL_SECONDARY_PASS=your_16_char_app_password

# ─── 8. GitHub Cloud Deployment & Continuous Integration ───────────────────────
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=https://github.com/your-org/your-repo.git

# ─── 9. Security, Webhook Verification & Studio Auth ──────────────────────────
INBOUND_WEBHOOK_SECRET=your_secret_token_here
DASHBOARD_API_KEY=your_master_api_bearer_token
REQUIRE_AUTH=true
STUDIO_USER=admin
STUDIO_PASS=your_master_api_bearer_token
UNSUB_SALT=your_random_salt_string
ALLOWED_ORIGINS=http://localhost:7880,http://localhost:8000,http://127.0.0.1:7880,http://127.0.0.1:8000,https://studio.flinzaworks.site,https://studio.flinzaworks.online

# ─── 10. Application Server & Production Routing ──────────────────────────────
PORT=7880
HOST=0.0.0.0
STUDIO_PORT=7880
DB_PATH=flinza.db
APP_BASE_URL=https://studio.flinzaworks.site
TRACKING_BASE_URL=https://studio.flinzaworks.site
