# Flinza — Standalone Email Outreacher Bot
# Copy this file to .env and fill in your values

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id_here

# AI Keys — at least one required
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Email Routing — optional, for unlimited alias generation
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_DOMAIN=yourdomain.com

# Google OAuth 2.0 — for Sign in with Google / Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Flinza Studio & Tracking
STUDIO_PORT=8000
TRACKING_BASE_URL=http://localhost:8000

DB_PATH=flinza.db
